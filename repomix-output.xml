    if (!activeSheet) return;
    const handleTelegramBack = () => {
      setActiveSheet(null);
    };
    window.addEventListener('neelyo:telegram-back', handleTelegramBack);
    return () => {
      window.removeEventListener('neelyo:telegram-back', handleTelegramBack);
