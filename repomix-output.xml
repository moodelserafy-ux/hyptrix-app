                  strokeWidth="3.4"
                />
                {/* Vertical alif/lam architectural verticals */}
                <path
                  d="M-16,-28 L-16,-9 M2,-29 L2,-11 M24,-28 L24,-9 M48,-27 L48,-10 M66,-28 L66,-11"
