        <rect x="0" y="0" width="320" height="190" fill={`url(#${uid}_sheen)`} />
        <rect x="0" y="0" width="320" height="190" fill={`url(#${uid}_vignette)`} />
      </g>

      {/* Luxury Gilded Hairline Inner Frame */}
      <rect
        x="1.5"
        y="1.5"
        width="317"
        height="187"
        rx="13"
        stroke={`url(#${uid}_gold)`}
        strokeWidth="2.5"
        strokeOpacity="0.88"
      />
    </svg>
  );
}

export default WorldFlagArt;
