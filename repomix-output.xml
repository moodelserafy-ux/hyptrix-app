      return `${window.location.origin}/?ref=${encodeURIComponent(myStudioInstanceId)}`;
    }
    return `${getSiteUrl()}/?ref=${encodeURIComponent(myStudioInstanceId)}`;
  }, [botUsername, myStudioInstanceId]);

  const handleCopyReferralLink = async () => {
