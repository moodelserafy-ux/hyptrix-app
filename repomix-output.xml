                          key={y}
                          x1={0}
                          y1={y}
                          x2={500}
                          y2={y}
                          stroke="rgba(212,175,55,0.16)"
                          strokeDasharray="4 4"
                        />
                      ))}

                      <motion.polyline
                        key={`rival_line_${pointsData.length}`}
                        fill="none"
                        stroke="#D91624"
                        strokeWidth="2.5"
                        strokeDasharray="5 4"
