    setChildModalOpen,
    setPrWarRoomOpen,
    setStarForgeOpen,
    starForgeLocksOpened,
    claimEmergencyInvestorBailoutWithAd,
    lastEmergencyBailoutDay,
    bankruptcyDeadlineDay,
    ownedStudioAssets,
    purchaseStudioAsset,
    showToast,
    worldMarket,
    uiLanguage,
  } = useGameStore();

  const isAr = uiLanguage === 'ar';
  const dir = getUiDir(uiLanguage);
