            ceoName.trim() || (isEn ? 'Chief Executive' : 'المدير التنفيذي');
          const marketCountryEn =
            state.worldMarket === 'saudi' ? 'Saudi Arabia' : 'Egypt';
          return {
            hasSelectedMarket: true,
            studioCreated: true,
            studioName: cleanStudio,
            ceoName: cleanCeo,
