          );
          return;
        }

        const BAILOUT_COOLDOWN_DAYS = 30;
        if (
          state.lastEmergencyBailoutDay !== null &&
          state.gameDay - state.lastEmergencyBailoutDay < BAILOUT_COOLDOWN_DAYS
