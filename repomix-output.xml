                  aria-label={tr(uiLanguage, `Step ${idx + 1}`, `الخطوة ${idx + 1}`)}
                  className={`h-2 rounded-full transition-all cursor-pointer ${
                    idx === stepIndex
                      ? 'w-6 bg-[#D91624]'
                      : idx < stepIndex
                      ? 'w-2 bg-[#15803D]'
