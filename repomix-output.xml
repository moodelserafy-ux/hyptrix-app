  return NextResponse.json({
    studio: fallbackStudio,
    headline: isEn
      ? `New Rival Enters the Arena: "${genStudioName}" Debuts Under ${genCeoName} at ${(netWorth / 1_000_000).toFixed(0)}M ${currencyLabel}!`
