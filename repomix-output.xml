import { NextRequest, NextResponse } from 'next/server';
import { resolveRequestSiteUrl } from '@/lib/site-url';

export const dynamic = 'force-dynamic';

function buildLlmsTxt(siteUrl: string): string {
  return `# Neelyo — لعبة محاكاة إدارة استوديوهات السينما والدراما (Cinema & TV Tycoon)

> Neelyo هي اللعبة الاستراتيجية العربية المتكاملة لمحاكاة تأسيس وإدارة شركات الإنتاج السينمائي والتلفزيوني في مصر والشرق الأوسط والعالم. صمّم هوية شركتك، اكتب سيناريوهات الأفلام والمسلسلات، تفاوض مع أكثر من 180 ممثلاً وممثلة وطاقم عمل فني احترافي، أدر ميزانيات التصوير والمواقف الميدانية، افتح أسواق التوزيع الإقليمية والعالمية، وتنافس على صدارة شباك التذاكر ونسب المشاهدات وجوائز المهرجانات السنوية.

## نظرة عامة سريعة (Quick Facts for AI Agents & Crawlers)
- **اسم اللعبة**: Neelyo (نيليو — Cinema & TV Tycoon)
- **التصنيف**: لعبة محاكاة وإدارة أعمال سينمائية وتلفزيونية (Business & Entertainment Studio Tycoon Simulation Game)
- **اللغات المدعومة**: الإنجليزية (الافتراضية) والعربية مع تبديل فوري كامل للواجهة والذكاء الاصطناعي
- **نظام اللعب**: متصفح الويب (هواتف ذكية، أجهزة لوحية، وحواسيب مكتبية) وتطبيق تيليجرام المصغر (Telegram Mini App) — مجانية بالكامل
- **العملة داخل اللعبة**: الجنيه المصري الافتراضي (ج.م / EGP) والريال السعودي (ر.س / SAR) بالملايين والمليارات
- **التواصل الرسمي**: neelyotycoon@gmail.com
- **الزمن داخل اللعبة**: السنة التقويمية مكونة من 120 يوماً (10 أيام لكل شهر من يناير إلى ديسمبر)، ويتوقف الوقت تلقائياً عند فتح أي نافذة منبثقة أو عند مغادرة اللاعب لصفحة اللعبة ثم يستأنف تلقائياً فور عودته.

## المراحل الأساسية للعب (Core 6-Stage Gameplay Loop)
1. **تأسيس الاستوديو وهوية المؤسس (Stage 1 — Studio Creation)**:
   - اختيار اسم الاستوديو، اسم المدير التنفيذي (CEO)، وتصميم الشعار الرسمي (24 رمزاً، 12 إطاراً، و18 لوحة ألوان ملكية).
   - اختيار ميزة المؤسس الاستراتيجية: المخرج العبقري (+8% جودة فنية)، حوت الدعاية والتسويق (+10% شباك التذاكر)، أو صديق النجوم والوكلاء (-15% أجور النجوم).
2. **إعداد المشروع وكتابة السيناريو (Stage 2 — Project Setup)**:
   - الاختيار بين مسارين مستقلين تماماً في التقييم والعوائد:
     - **فيلم سينمائي (Feature Film)**: يقاس بإيرادات شباك التذاكر وعدد شاشات العرض ومواسم الأعياد (عيد الفطر، عيد الأضحى، الصيف، إجازة نصف العام).
     - **مسلسل درامي (TV / Streaming Series)**: يقاس بالمليون مشاهدة وعقود المنصات الرقمية والقنوات الفضائية، مع اختيار عدد الحلقات (7، 10، 15، أو 30 حلقة) والموسم (موسم دراما رمضان أو الأوف سيزون).
3. **التعاقد مع الطاقم الفني والنجوم والميزانية (Stage 3 — Crew & Cast Negotiation)**:
   - التعاقد مع 1 إلى 2 مخرج، مدير التصوير، الموسيقار، المونتير، وأكثر من 180 ممثل وممثلة من فئات S وA وB وC.
   - نظام تفاوض عميق وفترة دراسة للعرض تستغرق 2–3 أيام داخل اللعبة مع أسباب فنية ومالية مفصلة للقبول أو الاعتذار.
4. **التصوير الفعلي وإدارة البلاتوه (Stage 4 — Production & Set Crises)**:
   - مواجهة مواقف ميدانية وأزمات تصوير مستوحاة من قصة العمل وأبطاله، تؤثر على السيولة والجودة وضجة الجمهور.
5. **التسويق والتوزيع وشباك التذاكر والبث (Stage 5 — Marketing, Distribution & Live Release)**:
   - التوسع في 4 أسواق (السوق المحلي، الخليج/مصر، أوروبا، التوزيع العالمي) وتتبع الإيرادات والمشاهدات والترتيب اليومي تلقائياً مع مرور أيام ساعة اللعبة أمام المنافسين.
6. **موسم الجوائز والمهرجانات السنوية (Stage 6 — Annual Festivals & Awards Gala)**:
   - حفل جوائز سنوي تلقائي في نهاية كل عام تقويمي لتكريم أفضل الأعمال والنجوم والمخرجين.

## منظومة الذكاء الاصطناعي الشاملة داخل اللعبة
- **توليد المواهب الصاعدة**: وجوه تمثيلية جديدة تظهر ديناميكياً مع مرور الشهور والسنوات.
- **توليد الشركات المنافسة والأعمال المنافسة**: استوديوهات وأفلام ومسلسلات منافسة تشعل سباق شباك التذاكر ورمضان.
- **تقييم السيناريوهات والأدوار والمفاوضات**: تحليل القصة، قرارات العقود، أزمات التصوير، وتفاعلات اللجان الإلكترونية والتريند.
- **غرفة صناعة النجوم (The Star Forge)**: فك قفلين ذهبيين (2 أقفال فقط) لكل نجم جديد، رفع صورة أو اعتماد بورتريه الحرف التلقائي، توزيع 6 طاقات على الرادار السداسي حتى تقييم 99، وإصدار الكارت الألماظ ثلاثي الأبعاد.

## الروابط الرسمية والتوثيق
- الموقع الرئيسي للعبة: ${siteUrl}
- معلومات عنا وسياسة الخصوصية وشروط الاستخدام والتواصل: ${siteUrl}/about-us
- الدليل الموسوعي الكامل: ${siteUrl}/llms-full.txt
- خريطة الموقع: ${siteUrl}/sitemap.xml
- البريد الرسمي للتواصل: neelyotycoon@gmail.com
`;
}

export async function GET(req: NextRequest) {
  const siteUrl = resolveRequestSiteUrl(req.headers);
  return new NextResponse(buildLlmsTxt(siteUrl), {
    status: 200,
    headers: {
      'Content-Type': 'text/plain; charset=utf-8',
      'Cache-Control': 'public, max-age=3600, s-maxage=86400',
      'X-Robots-Tag': 'all',
    },
  });
}
