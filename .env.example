# AI providers (server-side only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase: auth + server-owned VIP state + leaderboard only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional development-only rewarded-ad simulator; never enable in production
NEXT_PUBLIC_ENABLE_AD_DEMO=false

# Server-side rewarded-ad receipt verifier. It must validate provider signatures/SSV and return
# { "verified": true, "event_id": "unique-provider-impression-id" } only for valid callbacks.
AD_REWARD_VERIFY_URL=
AD_REWARD_VERIFY_SECRET=
